# Known agent/product keyword map -> category, used to tag results for the Agents worksheet
$script:AgentKeywords = @{
    'Defender'                = 'AV/EDR'
    'CrowdStrike'             = 'AV/EDR'
    'SentinelOne'             = 'AV/EDR'
    'Symantec'                = 'AV/EDR'
    'McAfee'                  = 'AV/EDR'
    'Trend Micro'             = 'AV/EDR'
    'Qualys'                  = 'Vulnerability/Monitoring'
    'Splunk'                  = 'Monitoring'
    'Binalyze'                = 'DFIR'
    'SCOM'                    = 'Monitoring'
    'Nagios'                  = 'Monitoring'
    'Zabbix'                  = 'Monitoring'
    'Veeam'                   = 'Backup'
    'Commvault'                = 'Backup'
    'Azure Connected Machine' = 'Azure Arc'
