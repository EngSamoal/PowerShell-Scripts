function Get-AgentCategory {
    param([string]$Name)
    foreach ($kw in $script:AgentKeywords.Keys) {
        if ($Name -match [regex]::Escape($kw)) { return $script:AgentKeywords[$kw] }
    }
    return $null
}

function Get-WindowsGuestSoftware {
    param($VM, [System.Management.Automation.PSCredential]$Credential, [string]$Site)

    $script = @'
$paths = @(
  "HKLM:\Software\Microsoft\Windows\CurrentVersion\Uninstall\*",
  "HKLM:\Software\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall\*"
)
$sw = Get-ItemProperty $paths -ErrorAction SilentlyContinue |
  Where-Object { $_.DisplayName } |
  Select-Object DisplayName, DisplayVersion, Publisher |
  Sort-Object DisplayName -Unique
$tools = (Get-CimInstance -ClassName Win32_Product -Filter "Name='VMware Tools'" -ErrorAction SilentlyContinue).Version
$kernel = (Get-CimInstance Win32_OperatingSystem).Version
$out = [PSCustomObject]@{
  Software = $sw
  ToolsVersion = $tools
  OSVersion = $kernel
}
$out | ConvertTo-Json -Depth 4 -Compress
'@

    $raw = Invoke-GuestScriptSafe -VM $VM -ScriptText $script -ScriptType Powershell -Credential $Credential
    if (-not $raw) { return $null }

    try {
        $parsed = $raw | ConvertFrom-Json
        $swList = @($parsed.Software)
        $agents = $swList | Where-Object { Get-AgentCategory $_.DisplayName } | ForEach-Object {
            [PSCustomObject]@{
                VMName   = $VM.Name
                Site     = $Site
                Agent    = $_.DisplayName
                Version  = $_.DisplayVersion
                Category = Get-AgentCategory $_.DisplayName
            }
        }
        [PSCustomObject]@{
            VMName       = $VM.Name
            Site         = $Site
            OSFamily     = 'Windows'
            ToolsVersion = $parsed.ToolsVersion
            OSVersion    = $parsed.OSVersion
            SoftwareList = $swList
            AgentsFound  = $agents
        }
    }
    catch {
        Write-ErrorRecord -Stage 'WindowsSoftware' -ObjectName $VM.Name -ErrorMessage $_.Exception.Message
        return $null
    }
}

function Get-LinuxGuestSoftware {
    param($VM, [System.Management.Automation.PSCredential]$Credential, [string]$Site)

    $script = @'
KERNEL=$(uname -r)
TOOLS=$(vmware-toolbox-cmd -v 2>/dev/null || echo "open-vm-tools:$(dpkg -l open-vm-tools 2>/dev/null | grep ^ii | awk '{print $3}')")
if command -v dpkg >/dev/null 2>&1; then
  PKGS=$(dpkg-query -W -f='${Package}|${Version}\n' 2>/dev/null)
elif command -v rpm >/dev/null 2>&1; then
  PKGS=$(rpm -qa --qf '%{NAME}|%{VERSION}\n' 2>/dev/null)
else
  PKGS=""
fi
echo "KERNEL_START"
echo "$KERNEL"
echo "TOOLS_START"
echo "$TOOLS"
echo "PKGS_START"
echo "$PKGS"
'@

    $raw = Invoke-GuestScriptSafe -VM $VM -ScriptText $script -ScriptType Bash -Credential $Credential
    if (-not $raw) { return $null }

    try {
        $lines = $raw -split "`n"
        $kernelIdx = [array]::IndexOf($lines, 'KERNEL_START')
        $toolsIdx  = [array]::IndexOf($lines, 'TOOLS_START')
        $pkgsIdx   = [array]::IndexOf($lines, 'PKGS_START')

        $kernel = $lines[$kernelIdx + 1]
        $tools  = $lines[$toolsIdx + 1]
        $pkgLines = $lines[($pkgsIdx + 1)..($lines.Count - 1)] | Where-Object { $_ -match '\|' }

        $pkgList = $pkgLines | ForEach-Object {
            $parts = $_ -split '\|', 2
            [PSCustomObject]@{ DisplayName = $parts[0]; DisplayVersion = $parts[1] }
        }

        $agents = $pkgList | Where-Object { Get-AgentCategory $_.DisplayName } | ForEach-Object {
            [PSCustomObject]@{
                VMName   = $VM.Name
                Site     = $Site
                Agent    = $_.DisplayName
                Version  = $_.DisplayVersion
                Category = Get-AgentCategory $_.DisplayName
            }
        }

        [PSCustomObject]@{
            VMName       = $VM.Name
            Site         = $Site
            OSFamily     = 'Linux'
            ToolsVersion = $tools
            OSVersion    = $kernel
            SoftwareList = $pkgList
            AgentsFound  = $agents
        }
    }
    catch {
        Write-ErrorRecord -Stage 'LinuxSoftware' -ObjectName $VM.Name -ErrorMessage $_.Exception.Message
        return $null
    }
}

function Get-SoftwareInventoryForSite {
    param($Server, [string]$Site, $VMConfigInventory)

    if (-not $WindowsGuestCredential -and -not $LinuxGuestCredential) {
        Write-Log -Level WARN -Message "[$Site] No guest credentials supplied — skipping software/agent inventory."
        return @()
    }

    $eligible = $VMConfigInventory | Where-Object { $_.PowerState -eq 'PoweredOn' -and $_.ToolsStatus -in @('toolsOk', 'toolsOld') }
    $winVMs = $eligible | Where-Object { $_.GuestOSFullName -match '(?i)windows' }
    $linVMs = $eligible | Where-Object { $_.GuestOSFullName -match '(?i)linux|ubuntu|centos|rhel|debian|suse' }

    $winSample = Get-RandomSample -Source $winVMs -Count $SampleSize
    $linSample = Get-RandomSample -Source $linVMs -Count $SampleSize

    Write-Log -Level INFO -Message "[$Site] Sampled $($winSample.Count) Windows / $($linSample.Count) Linux VMs for software inventory."

    $results = [System.Collections.Generic.List[PSObject]]::new()

    foreach ($entry in $winSample) {
        if (-not $WindowsGuestCredential) { continue }
        $vm = Get-VM -Server $Server -Name $entry.VMName -ErrorAction SilentlyContinue
        if (-not $vm) { continue }
        Write-Log -Level INFO -Message "[$Site] Collecting Windows software: $($vm.Name)"
        $r = Get-WindowsGuestSoftware -VM $vm -Credential $WindowsGuestCredential -Site $Site
        if ($r) { $results.Add($r) }
    }

    foreach ($entry in $linSample) {
        if (-not $LinuxGuestCredential) { continue }
        $vm = Get-VM -Server $Server -Name $entry.VMName -ErrorAction SilentlyContinue
        if (-not $vm) { continue }
        Write-Log -Level INFO -Message "[$Site] Collecting Linux packages: $($vm.Name)"
        $r = Get-LinuxGuestSoftware -VM $vm -Credential $LinuxGuestCredential -Site $Site
        if ($r) { $results.Add($r) }
    }

    return $results
}

function Compare-SoftwareInventory {
    param($SFResults, $TBResults)

    $sfSoftwareNames = ($SFResults | ForEach-Object { $_.SoftwareList.DisplayName }) | Sort-Object -Unique
    $tbSoftwareNames = ($TBResults | ForEach-Object { $_.SoftwareList.DisplayName }) | Sort-Object -Unique

    $common   = $sfSoftwareNames | Where-Object { $_ -in $tbSoftwareNames }
    $onlySF   = $sfSoftwareNames | Where-Object { $_ -notin $tbSoftwareNames }
    $onlyTB   = $tbSoftwareNames | Where-Object { $_ -notin $sfSoftwareNames }

    $summary = foreach ($name in $common) {
        $sfVer = ($SFResults | ForEach-Object { $_.SoftwareList } | Where-Object { $_.DisplayName -eq $name } | Select-Object -ExpandProperty DisplayVersion -Unique) -join ';'
        $tbVer = ($TBResults | ForEach-Object { $_.SoftwareList } | Where-Object { $_.DisplayName -eq $name } | Select-Object -ExpandProperty DisplayVersion -Unique) -join ';'
        [PSCustomObject]@{
            SoftwareName    = $name
            Status          = 'Common'
            SF_Versions     = $sfVer
            TB_Versions     = $tbVer
            VersionMismatch = ($sfVer -ne $tbVer)
        }
    }
    $summary += $onlySF | ForEach-Object { [PSCustomObject]@{ SoftwareName = $_; Status = 'OnlyInSF'; SF_Versions = 'N/A'; TB_Versions = ''; VersionMismatch = $false } }
    $summary += $onlyTB | ForEach-Object { [PSCustomObject]@{ SoftwareName = $_; Status = 'OnlyInTB'; SF_Versions = ''; TB_Versions = 'N/A'; VersionMismatch = $false } }

    return $summary
}

#endregion

#region ------------------------------- MAIN EXECUTION -------------------------------

try {
    # ---- 1. Infrastructure ----
    $sfInfra = Get-InfrastructureSnapshot -Server $SFvCenter -Site 'SF'
    $tbInfra = Get-InfrastructureSnapshot -Server $TBvCenter -Site 'TB'
    $infraComparison = if ($sfInfra -and $tbInfra) { Compare-Infrastructure -SFData $sfInfra -TBData $tbInfra } else { @() }

    # ---- 2. Clusters ----
    $sfClusters = Get-ClusterSnapshot -Server $SFvCenter -Site 'SF'
    $tbClusters = Get-ClusterSnapshot -Server $TBvCenter -Site 'TB'
    $clusterComparison = Compare-Clusters -SFClusters $sfClusters -TBClusters $tbClusters

    # ---- 3. VM Configuration ----
    $sfVMConfig = Get-VMConfigInventory -Server $SFvCenter -Site 'SF'
    $tbVMConfig = Get-VMConfigInventory -Server $TBvCenter -Site 'TB'
    $vmConfigComparison = Compare-VMConfigurations -SFInventory $sfVMConfig -TBInventory $tbVMConfig

    # ---- 4. OS Inventory ----
    $sfOS = Get-OSInventorySummary -VMConfigInventory $sfVMConfig -Site 'SF'
    $tbOS = Get-OSInventorySummary -VMConfigInventory $tbVMConfig -Site 'TB'
    $osComparison = Compare-OSDistribution -SFOS $sfOS -TBOS $tbOS

    # ---- 5. Software & Agents ----
    $winSoftwareComparison = @()
    $linuxSoftwareComparison = @()
    $agentsComparison = @()
    if (-not $SkipSoftwareInventory) {
        $sfSoftware = Get-SoftwareInventoryForSite -Server $SFvCenter -Site 'SF' -VMConfigInventory $sfVMConfig
        $tbSoftware = Get-SoftwareInventoryForSite -Server $TBvCenter -Site 'TB' -VMConfigInventory $tbVMConfig

        $sfWin = $sfSoftware | Where-Object { $_.OSFamily -eq 'Windows' }
        $tbWin = $tbSoftware | Where-Object { $_.OSFamily -eq 'Windows' }
        $sfLin = $sfSoftware | Where-Object { $_.OSFamily -eq 'Linux' }
        $tbLin = $tbSoftware | Where-Object { $_.OSFamily -eq 'Linux' }

        $winSoftwareComparison = Compare-SoftwareInventory -SFResults $sfWin -TBResults $tbWin
        $linuxSoftwareComparison = Compare-SoftwareInventory -SFResults $sfLin -TBResults $tbLin
        $agentsComparison = ($sfSoftware + $tbSoftware) | ForEach-Object { $_.AgentsFound } | Where-Object { $_ }
    }
    else {
        Write-Log -Level WARN -Message "SkipSoftwareInventory set — software/agent comparison skipped."
    }

    # ---- Differences Summary ----
    $diffSummary = [System.Collections.Generic.List[PSObject]]::new()
    foreach ($row in ($infraComparison | Where-Object Mismatch)) {
        $diffSummary.Add([PSCustomObject]@{ Category = 'Infrastructure'; Item = $row.Metric; SF = $row.SF; TB = $row.TB })
    }
    foreach ($row in ($clusterComparison | Where-Object { $_.HA_Mismatch -or $_.DRS_Mismatch -or $_.EVC_Mismatch -or -not $_.PresentInBoth })) {
        $diffSummary.Add([PSCustomObject]@{ Category = 'Cluster'; Item = $row.MatchedClusterKey; SF = "HA:$($row.SF_HA) DRS:$($row.SF_DRSLevel) EVC:$($row.SF_EVC)"; TB = "HA:$($row.TB_HA) DRS:$($row.TB_DRSLevel) EVC:$($row.TB_EVC)" })
    }
    foreach ($row in ($vmConfigComparison.Matched | Where-Object HasMismatch)) {
        $diffSummary.Add([PSCustomObject]@{ Category = 'VM Config'; Item = $row.MatchKey; SF = $row.MismatchedFields; TB = '' })
    }
    foreach ($row in ($osComparison | Where-Object { $_.MissingInSF -or $_.MissingInTB -or $_.CountMismatch })) {
        $diffSummary.Add([PSCustomObject]@{ Category = 'OS Inventory'; Item = $row.OSName; SF = $row.SF_Count; TB = $row.TB_Count })
    }

    # ---- Execution Summary ----
    $endTime = Get-Date
    $execSummary = [PSCustomObject]@{
        StartTime           = $script:StartTime
        EndTime              = $endTime
        DurationMinutes      = [math]::Round(($endTime - $script:StartTime).TotalMinutes, 2)
        SFvCenter            = $SFvCenterServer
        TBvCenter            = $TBvCenterServer
        SFVMCount            = $sfVMConfig.Count
        TBVMCount            = $tbVMConfig.Count
        TotalErrors          = $script:ErrorLog.Count
        SoftwareInventorySkipped = [bool]$SkipSoftwareInventory
        SampleSizeUsed       = $SampleSize
    }

    # ---- Executive Summary (narrative) ----
    $execNarrative = [System.Collections.Generic.List[string]]::new()
    $execNarrative.Add("SF vs TB Environment Comparison — Executive Summary")
    $execNarrative.Add("Generated: $endTime")
    $execNarrative.Add("")
    $execNarrative.Add("Scope: SF vCenter '$SFvCenterServer' ($($sfVMConfig.Count) VMs) vs TB vCenter '$TBvCenterServer' ($($tbVMConfig.Count) VMs).")
    $execNarrative.Add("")
    $execNarrative.Add("Key differences identified: $($diffSummary.Count)")
    $haMismatch = ($clusterComparison | Where-Object HA_Mismatch).Count
    $drsMismatch = ($clusterComparison | Where-Object DRS_Mismatch).Count
    $evcMismatch = ($clusterComparison | Where-Object EVC_Mismatch).Count
    if ($haMismatch -gt 0) { $execNarrative.Add("- RISK: $haMismatch cluster(s) have mismatched HA configuration between sites.") }
    if ($drsMismatch -gt 0) { $execNarrative.Add("- RISK: $drsMismatch cluster(s) have mismatched DRS automation level.") }
    if ($evcMismatch -gt 0) { $execNarrative.Add("- RISK: $evcMismatch cluster(s) have mismatched EVC mode — live migration/compatibility risk.") }
    $vmMismatchCount = ($vmConfigComparison.Matched | Where-Object HasMismatch).Count
    if ($vmMismatchCount -gt 0) { $execNarrative.Add("- $vmMismatchCount matched VM pair(s) show configuration drift (hardware version, vCPU, memory, tools, etc.).") }
    $missingOSCount = ($osComparison | Where-Object { $_.MissingInSF -or $_.MissingInTB }).Count
    if ($missingOSCount -gt 0) { $execNarrative.Add("- $missingOSCount OS version(s) exist in one site but not the other — patch/build baseline drift.") }
    $toolsGap = ($sfInfra.ToolsNotInstalled + $sfInfra.ToolsNotRunning + $tbInfra.ToolsNotInstalled + $tbInfra.ToolsNotRunning)
    if ($toolsGap -gt 0) { $execNarrative.Add("- $toolsGap VM(s) across both sites have VMware Tools not installed/not running — reduces automation and monitoring coverage.") }
    if ($script:ErrorLog.Count -gt 0) { $execNarrative.Add("- $($script:ErrorLog.Count) collection error(s) occurred; see Errors sheet/log for detail — treat affected objects as unverified.") }
    $execNarrative.Add("")
    $execNarrative.Add("Recommendations:")
    $execNarrative.Add("1. Reconcile cluster HA/DRS/EVC settings to a common baseline across SF and TB.")
    $execNarrative.Add("2. Remediate VM Tools not-running/not-installed gaps to restore full guest visibility.")
    $execNarrative.Add("3. Align OS/patch baselines where version drift was found.")
    $execNarrative.Add("4. Investigate and re-run collection for any objects listed in the Errors sheet.")

    $execSummaryText = $execNarrative -join "`r`n"
    $execSummaryText | Out-File -FilePath (Join-Path $OutputPath 'ExecutiveSummary.txt') -Encoding utf8

    #region --- Exports ---
    Write-Log -Level INFO -Message "Writing CSV exports..."
    $csvMap = @{
        'Infrastructure_Comparison.csv' = $infraComparison
        'Cluster_Comparison.csv'        = $clusterComparison
        'VMConfig_Matched.csv'          = $vmConfigComparison.Matched
        'VMConfig_OnlyInSF.csv'         = $vmConfigComparison.OnlyInSF
        'VMConfig_OnlyInTB.csv'         = $vmConfigComparison.OnlyInTB
        'OS_Inventory_Comparison.csv'   = $osComparison
        'Windows_Software_Comparison.csv' = $winSoftwareComparison
        'Linux_Package_Comparison.csv'  = $linuxSoftwareComparison
        'Agents_Comparison.csv'         = $agentsComparison
        'Differences_Summary.csv'       = $diffSummary
        'Errors.csv'                    = $script:ErrorLog
        'Execution_Summary.csv'         = @($execSummary)
    }
    foreach ($kvp in $csvMap.GetEnumerator()) {
        try {
            if ($kvp.Value -and $kvp.Value.Count -gt 0) {
                $kvp.Value | Export-Csv -Path (Join-Path $CsvPath $kvp.Key) -NoTypeInformation -Encoding UTF8
            }
        }
        catch { Write-ErrorRecord -Stage 'CSV Export' -ObjectName $kvp.Key -ErrorMessage $_.Exception.Message }
    }
    Write-Log -Level SUCCESS -Message "CSV exports written to $CsvPath"

    if ($UseExcel) {
        Write-Log -Level INFO -Message "Writing Excel workbook..."
        try {
            if (Test-Path $ExcelFile) { Remove-Item $ExcelFile -Force }
            $sheetMap = [ordered]@{
                'Infrastructure'      = $infraComparison
                'Cluster Comparison'  = $clusterComparison
                'VM Config Matched'   = $vmConfigComparison.Matched
                'VM Only In SF'       = $vmConfigComparison.OnlyInSF
                'VM Only In TB'       = $vmConfigComparison.OnlyInTB
                'OS Inventory'        = $osComparison
                'Windows Software'    = $winSoftwareComparison
                'Linux Packages'      = $linuxSoftwareComparison
                'Agents Comparison'   = $agentsComparison
                'Differences Summary' = $diffSummary
                'Errors'              = $script:ErrorLog
                'Execution Summary'   = @($execSummary)
            }
            foreach ($kvp in $sheetMap.GetEnumerator()) {
                if ($kvp.Value -and $kvp.Value.Count -gt 0) {
                    $kvp.Value | Export-Excel -Path $ExcelFile -WorksheetName $kvp.Key -AutoSize -FreezeTopRow -BoldTopRow -TableStyle Medium6
                }
            }
            Write-Log -Level SUCCESS -Message "Excel workbook written to $ExcelFile"
        }
        catch {
            Write-ErrorRecord -Stage 'Excel Export' -ObjectName 'Workbook' -ErrorMessage $_.Exception.Message
        }
    }
    #endregion

    Write-Log -Level SUCCESS -Message "===== Comparison complete. Duration: $($execSummary.DurationMinutes) min. Errors: $($script:ErrorLog.Count) ====="
    Write-Host "`nReports:  $OutputPath" -ForegroundColor Cyan
    Write-Host "Log file: $LogFile" -ForegroundColor Cyan
}
catch {
    Write-Log -Level ERROR -Message "FATAL: $($_.Exception.Message)"
    Write-Log -Level ERROR -Message $_.ScriptStackTrace
    throw
}
finally {
    $script:ExecutionLog | Export-Csv -Path (Join-Path $LogPath 'ExecutionLog.csv') -NoTypeInformation -Encoding UTF8 -ErrorAction SilentlyContinue
}

#endregion
