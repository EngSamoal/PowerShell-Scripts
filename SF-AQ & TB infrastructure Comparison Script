```powershell
#Requires -Version 5.1
<#
.SYNOPSIS
    Comprehensive comparison of two VMware vSphere environments (SF vs TB) across
    infrastructure, cluster, VM configuration, OS, and installed software/agents.

.DESCRIPTION
    Connects to two already-connected vCenter Servers (via PowerCLI), collects and
    compares infrastructure, cluster, VM configuration, and guest OS/software data
    using VMware Tools (Invoke-VMScript) only — no WinRM required. Produces an
    Excel workbook (multi-sheet), CSV exports per report, a detailed log file, and
    an executive summary.

.NOTES
    Author   : Generated for Samoal (Al Qiddiya - Asset IT Operations)
    Requires : VMware PowerCLI (already connected to both vCenters before running)
               ImportExcel module (auto-detected; CSV-only fallback if unavailable)

.PARAMETER SFvCenterServer
    FQDN/name of the SF vCenter Server exactly as shown in $global:DefaultVIServers.

.PARAMETER TBvCenterServer
    FQDN/name of the TB vCenter Server exactly as shown in $global:DefaultVIServers.

.PARAMETER WindowsGuestCredential
    PSCredential used for Invoke-VMScript against Windows guests.

.PARAMETER LinuxGuestCredential
    PSCredential used for Invoke-VMScript against Linux guests.

.PARAMETER OutputPath
    Root folder for reports/logs. Defaults to .\SFTB-Comparison-<timestamp>.

.PARAMETER SampleSize
    Number of VMs randomly sampled per OS family per site for the software/agent
    deep-dive (spec default: 5).

.PARAMETER SkipSoftwareInventory
    Skips the guest-level software/agent comparison (infra/cluster/config/OS
    inventory still run). Useful for a fast pass or when Tools coverage is low.

.EXAMPLE
    $winCred = Get-Credential -Message "Windows guest admin"
    $linCred = Get-Credential -Message "Linux guest admin"
    .\Compare-SFTBEnvironments.ps1 -SFvCenterServer sf-vc01.aqcorp.local `
        -TBvCenterServer tb-vc01.aqcorp.local `
        -WindowsGuestCredential $winCred -LinuxGuestCredential $linCred
#>

[CmdletBinding()]
param(
    [Parameter(Mandatory = $true)]
    [string]$SFvCenterServer,

    [Parameter(Mandatory = $true)]
    [string]$TBvCenterServer,

    [Parameter(Mandatory = $false)]
    [System.Management.Automation.PSCredential]$WindowsGuestCredential,

    [Parameter(Mandatory = $false)]
    [System.Management.Automation.PSCredential]$LinuxGuestCredential,

    [Parameter(Mandatory = $false)]
    [string]$OutputPath = (Join-Path -Path (Get-Location) -ChildPath "SFTB-Comparison-$(Get-Date -Format 'yyyyMMdd-HHmmss')"),

    [Parameter(Mandatory = $false)]
    [ValidateRange(1, 50)]
    [int]$SampleSize = 5,

    [Parameter(Mandatory = $false)]
    [switch]$SkipSoftwareInventory
)

#region ------------------------------- INITIALIZATION -------------------------------

$ErrorActionPreference = 'Stop'
$script:StartTime = Get-Date
$script:ErrorLog = [System.Collections.Generic.List[PSObject]]::new()
$script:ExecutionLog = [System.Collections.Generic.List[PSObject]]::new()

# Folder layout
$null = New-Item -Path $OutputPath -ItemType Directory -Force
$CsvPath = Join-Path $OutputPath 'CSV'
$LogPath = Join-Path $OutputPath 'Logs'
$null = New-Item -Path $CsvPath -ItemType Directory -Force
$null = New-Item -Path $LogPath -ItemType Directory -Force
$LogFile = Join-Path $LogPath "SFTB-Comparison-$(Get-Date -Format 'yyyyMMdd-HHmmss').log"
$ExcelFile = Join-Path $OutputPath "SFTB-Comparison-$(Get-Date -Format 'yyyyMMdd-HHmmss').xlsx"

function Write-Log {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory = $true)][string]$Message,
        [ValidateSet('INFO', 'WARN', 'ERROR', 'SUCCESS')][string]$Level = 'INFO'
    )
    $ts = Get-Date -Format 'yyyy-MM-dd HH:mm:ss'
    $line = "[$ts] [$Level] $Message"
    $line | Out-File -FilePath $LogFile -Append -Encoding utf8

    switch ($Level) {
        'WARN'    { Write-Warning $Message }
        'ERROR'   { Write-Host $line -ForegroundColor Red }
        'SUCCESS' { Write-Host $line -ForegroundColor Green }
        default   { Write-Host $line -ForegroundColor Gray }
    }

    $script:ExecutionLog.Add([PSCustomObject]@{ Timestamp = $ts; Level = $Level; Message = $Message })
}

function Write-ErrorRecord {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory = $true)][string]$Stage,
        [Parameter(Mandatory = $true)][string]$ObjectName,
        [Parameter(Mandatory = $true)][string]$ErrorMessage
    )
    $script:ErrorLog.Add([PSCustomObject]@{
        Timestamp    = Get-Date -Format 'yyyy-MM-dd HH:mm:ss'
        Stage        = $Stage
        Object       = $ObjectName
        ErrorMessage = $ErrorMessage
    })
    Write-Log -Level ERROR -Message "[$Stage] $ObjectName -> $ErrorMessage"
}

Write-Log -Level INFO -Message "===== SF vs TB Environment Comparison started ====="
Write-Log -Level INFO -Message "Output path: $OutputPath"

# Verify PowerCLI + both vCenter connections already exist
if (-not (Get-Module -ListAvailable -Name VMware.PowerCLI -ErrorAction SilentlyContinue) -and
    -not (Get-Module -ListAvailable -Name VMware.VimAutomation.Core -ErrorAction SilentlyContinue)) {
    Write-Log -Level ERROR -Message "VMware PowerCLI module not found. Install-Module VMware.PowerCLI first."
    throw "PowerCLI not available."
}

$SFvCenter = $global:DefaultVIServers | Where-Object { $_.Name -eq $SFvCenterServer -and $_.IsConnected }
$TBvCenter = $global:DefaultVIServers | Where-Object { $_.Name -eq $TBvCenterServer -and $_.IsConnected }

if (-not $SFvCenter) { throw "Not connected to SF vCenter '$SFvCenterServer'. Connect-VIServer first." }
if (-not $TBvCenter) { throw "Not connected to TB vCenter '$TBvCenterServer'. Connect-VIServer first." }

Write-Log -Level SUCCESS -Message "Confirmed connections: SF=$($SFvCenter.Name) TB=$($TBvCenter.Name)"

# ImportExcel availability (soft dependency)
$UseExcel = $true
if (-not (Get-Module -ListAvailable -Name ImportExcel)) {
    Write-Log -Level WARN -Message "ImportExcel module not found. Will attempt to install from PSGallery; falling back to CSV-only if that fails."
    try {
        Install-Module -Name ImportExcel -Scope CurrentUser -Force -ErrorAction Stop
        Write-Log -Level SUCCESS -Message "ImportExcel installed."
    }
    catch {
        Write-Log -Level WARN -Message "Could not install ImportExcel ($($_.Exception.Message)). Continuing with CSV exports only."
        $UseExcel = $false
    }
}
if ($UseExcel) { Import-Module ImportExcel -ErrorAction SilentlyContinue }

#endregion

#region ------------------------------- HELPER FUNCTIONS -------------------------------

function Get-SiteLabel {
    param($Server)
    if ($Server.Name -eq $SFvCenterServer) { return 'SF' } else { return 'TB' }
}

function Test-ToolsReady {
    <# Returns $true only if VMware Tools is installed AND running #>
    param($VM)
    try {
        return ($VM.ExtensionData.Guest.ToolsStatus -in @('toolsOk', 'toolsOld') -and
                $VM.ExtensionData.Guest.ToolsRunningStatus -eq 'guestToolsRunning')
    }
    catch { return $false }
}

function Invoke-GuestScriptSafe {
    <# Wraps Invoke-VMScript with error handling; returns $null on failure instead of throwing #>
    param(
        [Parameter(Mandatory)]$VM,
        [Parameter(Mandatory)][string]$ScriptText,
        [Parameter(Mandatory)][ValidateSet('Bat', 'Powershell', 'Bash')][string]$ScriptType,
        [Parameter(Mandatory)][System.Management.Automation.PSCredential]$Credential
    )
    try {
        $result = Invoke-VMScript -VM $VM -ScriptText $ScriptText -ScriptType $ScriptType `
                    -GuestCredential $Credential -ErrorAction Stop
        return $result.ScriptOutput
    }
    catch {
        Write-ErrorRecord -Stage 'Invoke-VMScript' -ObjectName $VM.Name -ErrorMessage $_.Exception.Message
        return $null
    }
}

function Get-RandomSample {
    param([array]$Source, [int]$Count)
    if (-not $Source -or $Source.Count -eq 0) { return @() }
    $n = [Math]::Min($Count, $Source.Count)
    return $Source | Get-Random -Count $n
}

#endregion

#region ------------------------------- 1. INFRASTRUCTURE LEVEL -------------------------------

function Get-InfrastructureSnapshot {
    param($Server, [string]$Site)

    Write-Log -Level INFO -Message "[$Site] Collecting infrastructure snapshot..."
    Write-Progress -Activity "Infrastructure Collection" -Status $Site -PercentComplete 10

    try {
        $svcContent = Get-View ServiceInstance -Server $Server
        $aboutInfo  = $svcContent.Content.About

        $hosts       = Get-VMHost -Server $Server
        $datacenters = Get-Datacenter -Server $Server
        $clusters    = Get-Cluster -Server $Server
        $respools    = Get-ResourcePool -Server $Server | Where-Object { $_.Name -ne 'Resources' }
        $datastores  = Get-Datastore -Server $Server
        $vdswitches  = Get-VDSwitch -Server $Server -ErrorAction SilentlyContinue
        $stdswitches = Get-VirtualSwitch -Server $Server -Standard -ErrorAction SilentlyContinue
        $portgroups  = @(Get-VDPortgroup -Server $Server -ErrorAction SilentlyContinue) + @(Get-VirtualPortGroup -Server $Server -Standard -ErrorAction SilentlyContinue)
        $templates   = Get-Template -Server $Server -ErrorAction SilentlyContinue
        $allVMs      = Get-VM -Server $Server

        $poweredOn  = @($allVMs | Where-Object { $_.PowerState -eq 'PoweredOn' })
        $poweredOff = @($allVMs | Where-Object { $_.PowerState -eq 'PoweredOff' })

        $snapshots = Get-VM -Server $Server | Get-Snapshot -ErrorAction SilentlyContinue

        $toolsCurrent = @($allVMs | Where-Object { $_.ExtensionData.Guest.ToolsStatus -eq 'toolsOk' })
        $toolsOld     = @($allVMs | Where-Object { $_.ExtensionData.Guest.ToolsStatus -eq 'toolsOld' })
        $toolsNotRun  = @($allVMs | Where-Object { $_.ExtensionData.Guest.ToolsStatus -eq 'toolsNotRunning' })
        $toolsNotInst = @($allVMs | Where-Object { $_.ExtensionData.Guest.ToolsStatus -eq 'toolsNotInstalled' })

        [PSCustomObject]@{
            Site                    = $Site
            vCenterName             = $Server.Name
            vCenterVersion          = $aboutInfo.Version
            vCenterBuild            = $aboutInfo.Build
            ESXiHostCount           = $hosts.Count
            ESXiVersions            = ($hosts | Select-Object -ExpandProperty Version -Unique) -join ', '
            ESXiBuilds              = ($hosts | Select-Object -ExpandProperty Build -Unique) -join ', '
            DatacenterCount         = $datacenters.Count
            ClusterCount            = $clusters.Count
            ResourcePoolCount       = $respools.Count
            DatastoreCount          = $datastores.Count
            DatastoreTotalCapacityGB= [math]::Round(($datastores | Measure-Object -Property CapacityGB -Sum).Sum, 2)
            DatastoreFreeSpaceGB    = [math]::Round(($datastores | Measure-Object -Property FreeSpaceGB -Sum).Sum, 2)
            DistributedSwitchCount  = ($vdswitches | Measure-Object).Count
            StandardSwitchCount     = ($stdswitches | Measure-Object).Count
            PortGroupCount          = ($portgroups | Measure-Object).Count
            TemplateCount           = ($templates | Measure-Object).Count
            TotalVMCount            = $allVMs.Count
            PoweredOnCount          = $poweredOn.Count
            PoweredOffCount         = $poweredOff.Count
            SnapshotCount           = ($snapshots | Measure-Object).Count
            ToolsOK                 = $toolsCurrent.Count
            ToolsOutOfDate          = $toolsOld.Count
            ToolsNotRunning         = $toolsNotRun.Count
            ToolsNotInstalled       = $toolsNotInst.Count
        }
    }
    catch {
        Write-ErrorRecord -Stage 'Infrastructure' -ObjectName $Site -ErrorMessage $_.Exception.Message
        return $null
    }
}

function Compare-Infrastructure {
    param($SFData, $TBData)

    $props = $SFData.PSObject.Properties.Name | Where-Object { $_ -notin @('Site', 'vCenterName') }
    foreach ($p in $props) {
        [PSCustomObject]@{
            Metric      = $p
            SF          = $SFData.$p
            TB          = $TBData.$p
            Difference  = if ($SFData.$p -is [ValueType] -and $TBData.$p -is [ValueType]) { $SFData.$p - $TBData.$p } else { 'N/A' }
            Mismatch    = ($SFData.$p -ne $TBData.$p)
        }
    }
}

#endregion

#region ------------------------------- 2. CLUSTER LEVEL -------------------------------

function Get-ClusterSnapshot {
    param($Server, [string]$Site)

    Write-Log -Level INFO -Message "[$Site] Collecting cluster configuration..."
    $clusters = Get-Cluster -Server $Server
    $results = foreach ($cl in $clusters) {
        try {
            $clView = $cl | Get-View
            $hostsInCluster = $cl | Get-VMHost
            $vmsInCluster = $cl | Get-VM

            $cpuUsageSum = ($hostsInCluster | Measure-Object -Property CpuUsageMhz -Sum).Sum
            $cpuTotalSum = ($hostsInCluster | Measure-Object -Property CpuTotalMhz -Sum).Sum
            $memUsageSum = ($hostsInCluster | Measure-Object -Property MemoryUsageGB -Sum).Sum
            $memTotalSum = ($hostsInCluster | Measure-Object -Property MemoryTotalGB -Sum).Sum

            $vsanEnabled = $false
            try { $vsanEnabled = [bool]$clView.ConfigurationEx.VsanConfigInfo.Enabled } catch {}

            [PSCustomObject]@{
                Site               = $Site
                ClusterName        = $cl.Name
                HAEnabled          = $cl.HAEnabled
                HAAdmissionControl = $cl.HAAdmissionControlEnabled
                DRSEnabled         = $cl.DrsEnabled
                DRSAutomationLevel = $cl.DrsAutomationLevel
                EVCMode            = $cl.EVCMode
                vSANEnabled        = $vsanEnabled
                HostCount          = $hostsInCluster.Count
                VMCount            = $vmsInCluster.Count
                CpuUsagePct        = if ($cpuTotalSum -gt 0) { [math]::Round(($cpuUsageSum / $cpuTotalSum) * 100, 1) } else { 0 }
                MemUsagePct        = if ($memTotalSum -gt 0) { [math]::Round(($memUsageSum / $memTotalSum) * 100, 1) } else { 0 }
            }
        }
        catch {
            Write-ErrorRecord -Stage 'Cluster' -ObjectName $cl.Name -ErrorMessage $_.Exception.Message
        }
    }
    return $results
}

function Compare-Clusters {
    param($SFClusters, $TBClusters)

    # Match by normalized name (strip site prefix/suffix like "SF-", "-TB")
    $sfNorm = $SFClusters | ForEach-Object { $_ | Add-Member -NotePropertyName NormName -NotePropertyValue ($_.ClusterName -replace '(?i)^(sf|tb)[-_]|[-_](sf|tb)$', '') -PassThru -Force }
    $tbNorm = $TBClusters | ForEach-Object { $_ | Add-Member -NotePropertyName NormName -NotePropertyValue ($_.ClusterName -replace '(?i)^(sf|tb)[-_]|[-_](sf|tb)$', '') -PassThru -Force }

    $allNames = ($sfNorm.NormName + $tbNorm.NormName) | Sort-Object -Unique
    foreach ($name in $allNames) {
        $sfC = $sfNorm | Where-Object { $_.NormName -eq $name } | Select-Object -First 1
        $tbC = $tbNorm | Where-Object { $_.NormName -eq $name } | Select-Object -First 1

        [PSCustomObject]@{
            MatchedClusterKey = $name
            SF_ClusterName    = $sfC.ClusterName
            TB_ClusterName    = $tbC.ClusterName
            SF_HA             = $sfC.HAEnabled
            TB_HA             = $tbC.HAEnabled
            HA_Mismatch       = ($sfC.HAEnabled -ne $tbC.HAEnabled)
            SF_DRS            = $sfC.DRSEnabled
            TB_DRS            = $tbC.DRSEnabled
            SF_DRSLevel       = $sfC.DRSAutomationLevel
            TB_DRSLevel       = $tbC.DRSAutomationLevel
            DRS_Mismatch      = ($sfC.DRSAutomationLevel -ne $tbC.DRSAutomationLevel)
            SF_EVC            = $sfC.EVCMode
            TB_EVC            = $tbC.EVCMode
            EVC_Mismatch      = ($sfC.EVCMode -ne $tbC.EVCMode)
            SF_vSAN           = $sfC.vSANEnabled
            TB_vSAN           = $tbC.vSANEnabled
            SF_Hosts          = $sfC.HostCount
            TB_Hosts          = $tbC.HostCount
            SF_CpuUsagePct    = $sfC.CpuUsagePct
            TB_CpuUsagePct    = $tbC.CpuUsagePct
            SF_MemUsagePct    = $sfC.MemUsagePct
            TB_MemUsagePct    = $tbC.MemUsagePct
            PresentInBoth     = ($null -ne $sfC -and $null -ne $tbC)
        }
    }
}

#endregion

#region ------------------------------- 3. VM CONFIGURATION LEVEL -------------------------------

function Get-VMConfigInventory {
    param($Server, [string]$Site)

    Write-Log -Level INFO -Message "[$Site] Collecting VM configuration inventory..."
    $vms = Get-VM -Server $Server
    $total = $vms.Count
    $i = 0
    $results = foreach ($vm in $vms) {
        $i++
        if ($i % 25 -eq 0) {
            Write-Progress -Activity "VM Config Inventory ($Site)" -Status "$i / $total" -PercentComplete (($i / $total) * 100)
        }
        try {
            $disks = Get-HardDisk -VM $vm -ErrorAction SilentlyContinue
            $nics  = Get-NetworkAdapter -VM $vm -ErrorAction SilentlyContinue
            $scsi  = Get-ScsiController -VM $vm -ErrorAction SilentlyContinue
            $tags  = try { (Get-TagAssignment -Entity $vm -ErrorAction SilentlyContinue).Tag.Name -join ';' } catch { '' }
            $custAttrs = try { ($vm | Get-Annotation -ErrorAction SilentlyContinue | ForEach-Object { "$($_.Name)=$($_.Value)" }) -join ';' } catch { '' }

            [PSCustomObject]@{
                Site              = $Site
                VMName            = $vm.Name
                PowerState        = $vm.PowerState
                HardwareVersion   = $vm.HardwareVersion -as [string]
                GuestOSFullName   = $vm.ExtensionData.Guest.GuestFullName
                GuestOSId         = $vm.ExtensionData.Config.GuestId
                NumCpu            = $vm.NumCpu
                MemoryGB          = $vm.MemoryGB
                DiskCount         = ($disks | Measure-Object).Count
                TotalDiskGB       = [math]::Round(($disks | Measure-Object -Property CapacityGB -Sum).Sum, 2)
                ScsiControllers   = (($scsi | Select-Object -ExpandProperty Type) -join ';')
                NetworkAdapters   = (($nics | ForEach-Object { "$($_.Type):$($_.NetworkName)" }) -join ';')
                ToolsStatus       = $vm.ExtensionData.Guest.ToolsStatus
                ToolsVersion      = $vm.ExtensionData.Guest.ToolsVersion
                Tags              = $tags
                CustomAttributes  = $custAttrs
            }
        }
        catch {
            Write-ErrorRecord -Stage 'VMConfig' -ObjectName $vm.Name -ErrorMessage $_.Exception.Message
        }
    }
    Write-Progress -Activity "VM Config Inventory ($Site)" -Completed
    return $results
}

function Compare-VMConfigurations {
    param($SFInventory, $TBInventory)

    # Match VMs by base name (strip trailing/leading site tokens) — falls back to exact name match
    function Get-BaseName($n) { ($n -replace '(?i)^(sf|tb)[-_]|[-_](sf|tb)$', '') }

    $sfByBase = $SFInventory | Group-Object { Get-BaseName $_.VMName }
    $tbByBase = $TBInventory | Group-Object { Get-BaseName $_.VMName }
    $tbLookup = @{}
    foreach ($g in $tbByBase) { $tbLookup[$g.Name] = $g.Group[0] }

    $rows = foreach ($g in $sfByBase) {
        $sf = $g.Group[0]
        $tb = $tbLookup[$g.Name]
        if (-not $tb) { continue }

        $fieldsToCompare = @('HardwareVersion', 'GuestOSId', 'NumCpu', 'MemoryGB', 'DiskCount', 'TotalDiskGB', 'ScsiControllers', 'ToolsVersion', 'PowerState')
        $mismatches = @()
        foreach ($f in $fieldsToCompare) {
            if ($sf.$f -ne $tb.$f) { $mismatches += $f }
        }

        [PSCustomObject]@{
            MatchKey           = $g.Name
            SF_VMName          = $sf.VMName
            TB_VMName          = $tb.VMName
            SF_HWVersion       = $sf.HardwareVersion
            TB_HWVersion       = $tb.HardwareVersion
            SF_GuestOS         = $sf.GuestOSId
            TB_GuestOS         = $tb.GuestOSId
            SF_vCPU            = $sf.NumCpu
            TB_vCPU            = $tb.NumCpu
            SF_MemoryGB        = $sf.MemoryGB
            TB_MemoryGB        = $tb.MemoryGB
            SF_DiskCount       = $sf.DiskCount
            TB_DiskCount       = $tb.DiskCount
            SF_ToolsVersion    = $sf.ToolsVersion
            TB_ToolsVersion    = $tb.ToolsVersion
            MismatchedFields   = ($mismatches -join ';')
            HasMismatch        = ($mismatches.Count -gt 0)
        }
    }

    $unmatchedSF = $SFInventory | Where-Object { (Get-BaseName $_.VMName) -notin $tbLookup.Keys }
    $unmatchedTB = $TBInventory | Where-Object {
        $base = Get-BaseName $_.VMName
        -not ($SFInventory | Where-Object { (Get-BaseName $_.VMName) -eq $base })
    }

    [PSCustomObject]@{
        Matched      = $rows
        OnlyInSF     = $unmatchedSF
        OnlyInTB     = $unmatchedTB
    }
}

#endregion

#region ------------------------------- 4. OS INVENTORY LEVEL -------------------------------

function Get-OSInventorySummary {
    param($VMConfigInventory, [string]$Site)

    $VMConfigInventory |
        Where-Object { $_.GuestOSFullName } |
        Group-Object GuestOSFullName |
        ForEach-Object {
            [PSCustomObject]@{
                Site         = $Site
                OSName       = $_.Name
                Count        = $_.Count
                ToolsVersions= (($_.Group | Select-Object -ExpandProperty ToolsVersion -Unique) -join ';')
            }
        }
}

function Compare-OSDistribution {
    param($SFOS, $TBOS)

    $allOS = ($SFOS.OSName + $TBOS.OSName) | Sort-Object -Unique
    foreach ($os in $allOS) {
        $sfEntry = $SFOS | Where-Object { $_.OSName -eq $os }
        $tbEntry = $TBOS | Where-Object { $_.OSName -eq $os }
        [PSCustomObject]@{
            OSName        = $os
            SF_Count      = if ($sfEntry) { $sfEntry.Count } else { 0 }
            TB_Count      = if ($tbEntry) { $tbEntry.Count } else { 0 }
            MissingInSF   = (-not $sfEntry)
            MissingInTB   = (-not $tbEntry)
            CountMismatch = ($(if ($sfEntry) { $sfEntry.Count } else { 0 }) -ne $(if ($tbEntry) { $tbEntry.Count } else { 0 }))
        }
    }
}

